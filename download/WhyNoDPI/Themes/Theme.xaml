<!--
    WhyNoDPI — design system.
    All colours, typography and control templates live here so that every page
    stays visually consistent and the window markup stays readable.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== Palette ============================== -->
    <Color x:Key="BgColor">#FF070C15</Color>
    <Color x:Key="AccentColor">#FF4D8DFF</Color>
    <Color x:Key="SuccessColor">#FF35D499</Color>
    <Color x:Key="WarnColor">#FFF5B942</Color>
    <Color x:Key="DangerColor">#FFF1646F</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#FF070C15" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF0A1120" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF0F1828" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#FF121D30" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#FF16233A" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#FF1E2C46" />
    <SolidColorBrush x:Key="OutlineSoftBrush" Color="#FF172335" />
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="#FF2C4267" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE9F0FB" />
    <SolidColorBrush x:Key="TextSoftBrush" Color="#FFC2D0E6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8B9BB5" />
    <SolidColorBrush x:Key="MutedDimBrush" Color="#FF687891" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4D8DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF649DFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF3F7BE8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF16294A" />
    <SolidColorBrush x:Key="CyanBrush" Color="#FF56CCF2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF35D499" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FF0F2E25" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFF5B942" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FF2C2413" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF1646F" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FF2E1620" />
    <SolidColorBrush x:Key="FieldBrush" Color="#FF0A121F" />

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0A1220" Offset="0" />
        <GradientStop Color="#FF070C15" Offset="0.55" />
        <GradientStop Color="#FF05080F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF16305C" Offset="0" />
        <GradientStop Color="#FF112444" Offset="0.5" />
        <GradientStop Color="#FF0F1828" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF4D8DFF" Offset="0" />
        <GradientStop Color="#FF56CCF2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3E7BF0" Offset="0" />
        <GradientStop Color="#FF6B49F5" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AmbientGlow" GradientOrigin="0.72,0.02" Center="0.72,0.02" RadiusX="0.85" RadiusY="0.75">
        <GradientStop Color="#33274E9E" Offset="0" />
        <GradientStop Color="#0F1B3A6E" Offset="0.55" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="6" Direction="270"
                      Color="#FF000000" Opacity="0.45" RenderingBias="Performance" />
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="3" Direction="270"
                      Color="#FF000000" Opacity="0.35" RenderingBias="Performance" />


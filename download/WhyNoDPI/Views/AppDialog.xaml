<Window x:Class="NoDPI.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhyNoDPI"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <Border Margin="20" Background="#FF111C2E" BorderBrush="{StaticResource OutlineStrongBrush}"
            BorderThickness="1" CornerRadius="16" Padding="24,22,24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="12" Direction="270"
                              Color="#FF000000" Opacity="0.65" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="11"
                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="i" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="WhyNoDPI" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText" Text="" Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                <TextBlock x:Name="MessageText" Text="" TextWrapping="Wrap"
                           Style="{StaticResource Text.Body}" LineHeight="20" />
            </ScrollViewer>

            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,18,0,0" />
        </StackPanel>
    </Border>
</Window>

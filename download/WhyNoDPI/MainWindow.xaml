<Window x:Class="NoDPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhyNoDPI"
        Height="880" Width="1400"
        MinHeight="720" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="MainWindow_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Compact pill used for the journal level filter. -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipSurface" Background="#FF101B2D"
                                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="11,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="#FF17253C" />
                                <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ChipSurface" Property="BorderBrush" Value="#554D8DFF" />
                                <Setter Property="Foreground" Value="#FFDCEAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square tile that hosts a service monogram. -->
        <Style x:Key="Monogram" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MonogramText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource MutedDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One "name — value" line used by readiness summaries. -->
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowGradient}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="254" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Ambient colour wash behind the content only. -->
        <Border Grid.Column="1" Background="{StaticResource AmbientGlow}" IsHitTestVisible="False" />

        <!-- ====================== Sidebar ====================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource OutlineSoftBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="4,2,0,26">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource LogoGradient}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                                                  Color="#FF4D6BFF" Opacity="0.55" RenderingBias="Performance" />
                            </Border.Effect>
                            <TextBlock Text="Z" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock Text="WhyNoDPI" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="NETWORK ENGINE" FontSize="8.5" FontWeight="Bold"
                                       Foreground="{StaticResource MutedDimBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="НАВИГАЦИЯ" Style="{StaticResource Text.SectionLabel}" Margin="12,0,0,8" />
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="True" Checked="NavHome_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconHome}" Margin="0,0,11,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Главная" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStrategies" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="NavStrategies_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconLayers}" Margin="0,0,11,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Стратегии" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavTelegram" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="NavTelegram_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconSend}" Margin="0,0,11,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Telegram · VPN" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavJournal" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="NavJournal_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconLog}" Margin="0,0,11,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Журнал" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="NavSettings_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconBase}" Data="{StaticResource IconSliders}" Margin="0,0,11,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Настройки" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <Border Style="{StaticResource Divider}" Margin="2,18,2,16" />

                    <TextBlock Text="ДВИЖОК" Style="{StaticResource Text.SectionLabel}" Margin="12,0,0,8" />
                    <Border Background="#FF0E1727" BorderBrush="{StaticResource OutlineSoftBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SidebarStatusDot" Style="{StaticResource StatusDot}" Width="7" Height="7" />
                                <TextBlock x:Name="SidebarStatusText" Text="Выключен" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="SidebarEngineHint" Text="Профиль не выбран"
                                       Foreground="{StaticResource MutedDimBrush}" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="VersionText" Text="v1.1.0" Foreground="{StaticResource MutedDimBrush}"
                               FontSize="10" Margin="4,0,0,4" />
                    <TextBlock Text="Windows x64 · admin" Foreground="#FF4E5C72" FontSize="10" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====================== Content ====================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <!-- Home -->
                <Grid x:Name="HomePage">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="28,24,22,20">
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Главная" Style="{StaticResource Text.PageTitle}" />
                                    <TextBlock Text="Состояние обхода блокировок, быстрый запуск и проверка сервисов."
                                               Style="{StaticResource Text.PageSubtitle}" />
                                </StackPanel>
                                <Border Style="{StaticResource Badge}" Tag="accent" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HeaderStatusDot" Style="{StaticResource StatusDot}" Width="6" Height="6"
                                                 Margin="0,0,7,0" />
                                        <TextBlock x:Name="HeaderStatusText" Text="Движок выключен"
                                                   Style="{StaticResource BadgeText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.55*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left column -->
                                <StackPanel Grid.Column="0">
                                    <!-- Hero -->
                                    <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradient}"
                                            BorderBrush="#FF24406C" Padding="24" Margin="0,0,0,16"
                                            Effect="{StaticResource CardShadow}">
                                        <Grid>
                                            <Grid ClipToBounds="True">
                                                <Border Background="{StaticResource AmbientGlow}" Margin="-40,-60,0,0"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                            <Path Data="{StaticResource IconShield}" Fill="#0AFFFFFF"
                                                  Width="210" Height="210" Stretch="Uniform"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,-34,0" IsHitTestVisible="False" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,4,9,0"
                                                             Fill="{StaticResource MutedDimBrush}" />
                                                    <TextBlock Text="СЕТЕВОЙ ДВИЖОК" Foreground="#FF9EC0FF" FontSize="10"
                                                               FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock x:Name="StatusText" Text="Проверка…" FontSize="29"
                                                           FontWeight="Bold" Foreground="#FFFFFFFF"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="ModuleStatus" Text="Подготовка приложения"
                                                           Foreground="#FFB7C8E2" FontSize="12.5" TextWrapping="Wrap"
                                                           MinHeight="38" Margin="0,8,0,18" MaxWidth="520"
                                                           HorizontalAlignment="Left" />

                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="ToggleButton" Content="Включить Zapret" Width="186" Height="42"
                                                            Style="{StaticResource Btn.Primary}" Click="ToggleButton_Click" />
                                                    <Button x:Name="AutoDetectButtonHome" Content="Подобрать стратегию" Height="42"
                                                            Margin="10,0,0,0" Click="AutoDetectButton_Click" />
                                                </StackPanel>

                                                <Border Style="{StaticResource Divider}" Margin="0,20,0,14" Background="#26FFFFFF" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="ПРОФИЛЬ" Foreground="#FF8FA8CC" FontSize="9.5"
                                                                   FontWeight="Bold" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="HeroProfileText" Text="не выбран"
                                                                   Foreground="#FFD8E4F7" FontSize="11.5"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="UptimeText" Grid.Column="1" Text=""
                                                               Foreground="#FF8FA8CC" FontSize="10.5"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Services -->
                                    <Grid Margin="2,6,2,10">
                                        <TextBlock Text="ПРОВЕРКА СЕРВИСОВ" Style="{StaticResource Text.SectionLabel}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <Button x:Name="CheckServicesButton" Content="Проверить" Style="{StaticResource Btn.Small}"
                                                HorizontalAlignment="Right" Click="CheckServices_Click" />
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Monogram}" Background="#FF2C1618">
                                                        <TextBlock Text="YT" Style="{StaticResource MonogramText}" Foreground="#FFFF7A80" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="YouTube" FontSize="13.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                    <Ellipse x:Name="YoutubeDot" Grid.Column="2" Style="{StaticResource StatusDot}" />
                                                </Grid>
                                                <TextBlock x:Name="YoutubeStatus" Text="Ещё не проверялся"
                                                           Style="{StaticResource Text.Caption}" MinHeight="34" Margin="0,11,0,0" />
                                                <Button Content="Открыть" Style="{StaticResource Btn.Small}"
                                                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="OpenYoutube_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Monogram}" Background="#FF1B2140">
                                                        <TextBlock Text="DC" Style="{StaticResource MonogramText}" Foreground="#FF9AA9FF" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Discord" FontSize="13.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                    <Ellipse x:Name="DiscordDot" Grid.Column="2" Style="{StaticResource StatusDot}" />
                                                </Grid>
                                                <TextBlock x:Name="DiscordStatus" Text="Приложение Discord"
                                                           Style="{StaticResource Text.Caption}" MinHeight="34" Margin="0,11,0,0" />
                                                <Button Content="Открыть" Style="{StaticResource Btn.Small}"
                                                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="OpenDiscord_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Monogram}" Background="#FF14283F">
                                                        <TextBlock Text="TG" Style="{StaticResource MonogramText}" Foreground="#FF5CC8F5" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Telegram" FontSize="13.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                                    <Ellipse x:Name="TelegramDot" Grid.Column="2" Style="{StaticResource StatusDot}" />
                                                </Grid>
                                                <TextBlock x:Name="TelegramStatus" Text="Ещё не проверялся"
                                                           Style="{StaticResource Text.Caption}" MinHeight="34" Margin="0,11,0,0" />
                                                <Button Content="Открыть" Style="{StaticResource Btn.Small}"
                                                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="OpenTelegram_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Recent events -->
                                    <Border Style="{StaticResource Card}" Padding="18,16,18,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="Последние события" Style="{StaticResource Text.CardTitle}" FontSize="13.5" />
                                                <Button Content="Весь журнал" Style="{StaticResource Btn.Link}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Click="OpenJournal_Click" />
                                            </Grid>
                                            <ItemsControl x:Name="RecentLogList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       Foreground="{StaticResource MutedDimBrush}"
                                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <Ellipse Grid.Column="1" Width="5" Height="5" Margin="0,0,9,0"
                                                                     Fill="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11.5"
                                                                       Foreground="{Binding TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="RecentLogEmpty" Text="Пока событий нет — включите движок или проверьте сервисы."
                                                       Style="{StaticResource Text.Caption}" Margin="0,2,0,6" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right column -->
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="АКТИВНЫЙ ПРОФИЛЬ" Style="{StaticResource Text.SectionLabel}" />
                                            <TextBlock x:Name="CurrentStrategy" Text="Не выбран" FontSize="19"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ActiveProfileFileText" Text="General"
                                                       Style="{StaticResource Text.Caption}" Margin="0,5,0,0" />
                                            <Border Style="{StaticResource Divider}" Margin="0,15,0,13" />
                                            <TextBlock Text="Профиль General из пакета Flowseal"
                                                       Style="{StaticResource Text.FieldLabel}" />
                                            <ComboBox x:Name="HomeStrategyBox" Height="38"
                                                      SelectionChanged="HomeStrategyBox_SelectionChanged"
                                                      ToolTip="Профиль General, который будет запущен в winws.exe" />
                                            <TextBlock x:Name="ProfileCountText" Text="Профили не найдены"
                                                       Style="{StaticResource Text.Caption}" Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Готовность пакета" Style="{StaticResource Text.CardTitle}" FontSize="13.5" />
                                            <Grid Margin="0,13,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Драйвер WinDivert" Style="{StaticResource Text.Caption}" />
                                                <TextBlock x:Name="CheckDriverText" Grid.Column="1" Text="—"
                                                           Style="{StaticResource SummaryValue}" />
                                            </Grid>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Профили General" Style="{StaticResource Text.Caption}" />
                                                <TextBlock x:Name="CheckProfilesText" Grid.Column="1" Text="—"
                                                           Style="{StaticResource SummaryValue}" />
                                            </Grid>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Права администратора" Style="{StaticResource Text.Caption}" />
                                                <TextBlock x:Name="CheckAdminText" Grid.Column="1" Text="—"
                                                           Style="{StaticResource SummaryValue}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Быстрый доступ" Style="{StaticResource Text.CardTitle}" FontSize="13.5" />
                                            <TextBlock Text="Ссылки открываются в браузере; при выключенном движке WhyNoDPI сначала поднимет выбранный профиль."
                                                       Style="{StaticResource Text.Caption}" Margin="0,7,0,14" />
                                            <Button Content="Telegram Web" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                                    Click="OpenTelegram_Click" />
                                            <Button Content="GitHub Flowseal" HorizontalAlignment="Stretch"
                                                    Click="OpenFlowseal_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Strategies -->
                <Grid x:Name="StrategiesPage" Visibility="Collapsed">
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <StackPanel Margin="28,24,22,20">
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Стратегии" Style="{StaticResource Text.PageTitle}" />
                                <TextBlock Text="WhyNoDPI найдёт general-профили и проверит каждый на вашей сети."
                                           Style="{StaticResource Text.PageSubtitle}" />
                            </StackPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Профиль Flowseal" Style="{StaticResource Text.CardTitle}" />
                                        <TextBlock Text="Параметры выбранного General передаются напрямую в winws.exe — без cmd.exe и BAT-файлов."
                                                   Style="{StaticResource Text.Caption}" Margin="0,6,0,14" />
                                        <ComboBox x:Name="StrategyBox" Height="40" SelectionChanged="StrategyBox_SelectionChanged">
                                            <ComboBoxItem Content="Сначала выберите пакет Flowseal" IsEnabled="False" />
                                        </ComboBox>
                                        <TextBlock x:Name="StrategyDescription" Text="Выберите пакет Flowseal в настройках."
                                                   Style="{StaticResource Text.Caption}" Margin="0,12,0,18" MinHeight="34" />
                                        <WrapPanel>
                                            <Button x:Name="AutoDetectButton" Content="Автоподбор" Click="AutoDetectButton_Click" />
                                            <Button x:Name="StartSelectedStrategyButton" Content="Запустить выбранный"
                                                    Margin="8,0,0,0" Click="StartSelectedStrategy_Click" />
                                            <Button x:Name="StopEngineButton" Content="Остановить" Style="{StaticResource Btn.Danger}"
                                                    Margin="8,0,0,0" Click="StopEngine_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Ход проверки" Style="{StaticResource Text.CardTitle}" />
                                            <Button x:Name="CancelTestButton" Content="Отменить" Style="{StaticResource Btn.Small}"
                                                    HorizontalAlignment="Right" Click="CancelTest_Click" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="TestProgressText" Text="Ожидание запуска"

                                                <TextBlock Text="Пакет Flowseal" Style="{StaticResource Text.Caption}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="ZapretUpdateStatus" Grid.Column="1" Text="не проверялось"
                                                           Style="{StaticResource SummaryValue}" />
                                            </Grid>
                                            <WrapPanel Margin="0,13,0,0">
                                                <Button x:Name="CheckUpdatesButton" Content="Проверить"
                                                        Style="{StaticResource Btn.Small}" Click="CheckUpdates_Click" />
                                                <Button x:Name="AppUpdateButton" Content="Скачать" Visibility="Collapsed"
                                                        Style="{StaticResource Btn.Small}" Margin="8,0,0,0"
                                                        Click="OpenAppDownload_Click" />
                                                <Button x:Name="ZapretUpdateButton" Content="Релиз Flowseal" Visibility="Collapsed"
                                                        Style="{StaticResource Btn.Small}" Margin="8,0,0,0"
                                                        Click="OpenFlowsealRelease_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Служебные папки" Style="{StaticResource Text.CardTitle}" />
                                            <TextBlock Text="Журналы запуска, кэш профилей и файл настроек."
                                                       Style="{StaticResource Text.Caption}" Margin="0,6,0,14" />
                                            <Button Content="Открыть данные приложения" HorizontalAlignment="Stretch"
                                                    Click="OpenDataFolder_Click" />
                                            <Button Content="Открыть папку логов" HorizontalAlignment="Stretch"
                                                    Margin="0,8,0,0" Click="OpenLogs_Click" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Обновление пакета Flowseal" Style="{StaticResource Text.CardTitle}" />
                                            <TextBlock Text="Профили General импортируются автоматически: после выбора новой папки список профилей обновится сам."
                                                       Style="{StaticResource Text.Caption}" Margin="0,6,0,14" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="1" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Скачайте свежий архив Flowseal по кнопке «Скачать Flowseal»."
                                                           Style="{StaticResource Text.Caption}" Margin="10,1,0,0" />
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="2" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Распакуйте его в папку без пробелов и кириллицы, например C:\zapret-flowseal."
                                                           Style="{StaticResource Text.Caption}" Margin="10,1,0,0" />
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="3" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Нажмите «Выбрать папку» — WhyNoDPI проверит пакет и импортирует профили."
                                                           Style="{StaticResource Text.Caption}" Margin="10,1,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Горячие клавиши" Style="{StaticResource Text.CardTitle}" FontSize="13.5" />
                                            <Grid Margin="0,13,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Badge}" Padding="7,2">
                                                    <TextBlock Text="F5" Style="{StaticResource BadgeText}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Проверить сервисы" Style="{StaticResource Text.Caption}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Badge}" Padding="7,2">
                                                    <TextBlock Text="Ctrl+1…5" Style="{StaticResource BadgeText}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Переключение разделов" Style="{StaticResource Text.Caption}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="1" Background="#F20A1120" BorderBrush="{StaticResource OutlineSoftBrush}"
                    BorderThickness="0,1,0,0" Padding="24,0" Height="34">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusBarDot" Style="{StaticResource StatusDot}" Width="7" Height="7" />
                        <TextBlock x:Name="StatusBarText" Text="Движок выключен" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                        <Border Width="1" Height="12" Background="{StaticResource OutlineBrush}" Margin="14,0" />
                        <TextBlock x:Name="StatusBarProfile" Text="Профиль: не выбран" FontSize="11"
                                   Foreground="{StaticResource MutedDimBrush}" />
                        <Border Width="1" Height="12" Background="{StaticResource OutlineBrush}" Margin="14,0" />
                        <TextBlock x:Name="StatusBarCheck" Text="Сервисы не проверялись" FontSize="11"
                                   Foreground="{StaticResource MutedDimBrush}" />
                    </StackPanel>
                    <TextBlock Text="F5 — проверить сервисы · Ctrl+1…5 — разделы" FontSize="10.5"
                               Foreground="#FF4E5C72" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Toasts -->
            <StackPanel x:Name="ToastStack" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,28,26" IsHitTestVisible="False" Width="360" />
        </Grid>
    </Grid>
</Window>

# Локальный запуск (SQLite): скопируйте в .env
# Prisma считает относительный путь от папки prisma/, поэтому «../db/…» —
# это db/custom.db в корне проекта.
DATABASE_URL="file:../db/custom.db"

# Vercel / Postgres: вместо строки выше укажите pooled-строку подключения
# (Neon даёт её с суффиксом -pooler). Параметры pgbouncer нужны для serverless.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Пароль администратора хранится только как scrypt-хеш.
# Сгенерировать: node scripts/hash-password.mjs "ваш пароль"
ADMIN_PASSWORD_HASH="scrypt:16384:8:1:saltHex:hashHex"

# Перец для хеширования installId и IP. Сгенерировать:
# node scripts/hash-password.mjs "пароль" --pepper  (вторая строка)
TELEMETRY_PEPPER="replace-with-at-least-32-random-bytes"

SESSION_TTL_HOURS="8"
ONLINE_WINDOW_SECONDS="150"
